[Unit]
Description=Predictor Trading System
Documentation=https://github.com/tyjodu/prediction-market
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=predictor
Group=predictor

WorkingDirectory=/data/predictor/prediction-market

# Load all environment variables from .env file
EnvironmentFile=/data/predictor/.env

# Secrets backend. Required secrets are loaded from GCP Secret Manager; do not
# add credentials to this unit or its EnvironmentFile.
Environment="SECRETS_BACKEND=gcp"
Environment="SECRETS_STRICT=true"
Environment="GCP_PROJECT_ID=predictor-trading-2026"

# Python venv binary
ExecStart=/data/predictor/venv/bin/python \
    scripts/trading_session.py \
    --dashboard \
    --dashboard-port 8000 \
    --dashboard-host 0.0.0.0

# Restart policy: wait 30s before retrying on crash
Restart=on-failure
RestartSec=30
StartLimitIntervalSec=300
StartLimitBurst=5

# Logging — view with: journalctl -u predictor -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=predictor

# Resource limits
LimitNOFILE=65536
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
