# Prediction Market Trading System - Configuration Template
# Local paper-mode, non-secret runtime configuration only. Every variable here
# is read by the code; values shown are the code defaults unless noted.
# Production credentials (exchange keys, DASHBOARD_PASSWORD, alert webhook
# URLs) belong in GCP Secret Manager and must not be added here.

# Execution mode for development and paper-mode soak tests. This mode uses
# simulated fills only; it never places orders on either exchange.
EXECUTION_MODE=paper

# Secrets backend: env (local dev) or gcp (production, with SECRETS_STRICT=true)
SECRETS_BACKEND=env

# Database
DB_PATH=prediction_market.db

# Logging
LOG_LEVEL=INFO
# text or json
LOG_FORMAT=text

# Risk controls (paper/shadow). Fractions of STARTING_CAPITAL.
STARTING_CAPITAL=10000
MAX_POSITION_PCT=0.05
MAX_DAILY_LOSS_PCT=0.02
MAX_PORTFOLIO_EXPOSURE_PCT=0.20
KELLY_FRACTION=0.25
MIN_EDGE_TO_TRADE=0.02
CONSECUTIVE_FAILURE_LIMIT=5
# Live mode uses these stricter overrides instead (core/live_gate.py):
# LIVE_MAX_POSITION_PCT=0.02
# LIVE_MAX_DAILY_LOSS_PCT=0.01
# LIVE_MIN_EDGE_TO_TRADE=0.05

# Snapshots
PNL_SNAPSHOT_INTERVAL_S=300

# Execution
MAX_ORDER_RETRIES=3
RETRY_BACKOFF_BASE_S=1

# P1 arb: minimum expected profit in dollars after venue taker fees
# (net must always be > 0; this raises the floor).
ARB_MIN_NET_PROFIT=0.0
# Overrides trading_session.py --min-spread when set (99.0 pauses all P1 arb).
# MIN_SPREAD_CROSS_PLATFORM=0.03

# Alert policy configuration (non-secret)
# Warn when an open position exceeds this age (default: 72 hours).
AGED_POSITION_ALERT_THRESHOLD_S=259200
# Alert critically after more than this many submitted-order failures in the window.
EXECUTION_FAILURE_ALERT_COUNT=3
EXECUTION_FAILURE_ALERT_WINDOW_S=600
# Alert transport tuning. The webhook URLs themselves
# (ALERT_DISCORD_WEBHOOK_URL / ALERT_SLACK_WEBHOOK_URL) are secrets; alerts
# are a silent no-op when neither is configured.
ALERT_BOT_USERNAME=prediction-market-bot
ALERT_TIMEOUT_S=5
ALERT_DEDUP_WINDOW_S=300
ALERT_CRITICAL_DEDUP_WINDOW_S=10

# Dashboard (Basic Auth user; the password is a secret — DASHBOARD_PASSWORD)
DASHBOARD_USER=admin

# Polymarket
# Production Polymarket credentials are intentionally omitted.
# Live Polymarket client: v2 (py-clob-client-v2) or legacy (archived).
POLYMARKET_CLIENT=v2
POLYMARKET_API_BASE=https://clob.polymarket.com
# EU SOCKS5 proxy for Polymarket (optional — leave blank to connect directly)
# Format: socks5://host:port
POLYMARKET_PROXY=

# Kalshi
# Production Kalshi credentials are intentionally omitted.
KALSHI_API_BASE=https://api.elections.kalshi.com/trade-api/v2
KALSHI_PUBLIC_API_BASE=https://api.elections.kalshi.com/trade-api/v2
